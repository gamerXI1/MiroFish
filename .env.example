# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
# 可选：本地 OpenAI 兼容推理端点（例如已验证可用的 local-reasoning）
# 注意：即使本地服务忽略鉴权，LLM_API_KEY 也必须非空，因为 MiroFish 启动时会校验该配置
# LLM_API_KEY=dummy
# LLM_BASE_URL=http://127.0.0.1:30001/v1
# LLM_MODEL_NAME=local-reasoning

# ===== 外部研究侧车（可选，已验证可由 Hermes 支撑）=====
# MiroFish 会向 {EXTERNAL_RESEARCH_BASE_URL}/research/query 发送结构化查询。
# 如果你运行 backend/run_hermes_research_sidecar.py，可使用下面的本地配置：
# EXTERNAL_RESEARCH_BASE_URL=http://127.0.0.1:8788
# EXTERNAL_RESEARCH_TIMEOUT_SECONDS=60
# EXTERNAL_RESEARCH_API_KEY=
# 可选：为侧车指定独立 Hermes 环境或命令
# HERMES_RESEARCH_HERMES_HOME=/path/to/hermes-home
# HERMES_RESEARCH_COMMAND=hermes

# ===== ZEP记忆图谱配置 =====
# 默认后端：Zep Cloud
# GRAPH_BACKEND_PROVIDER=zep_cloud
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# 实验性迁移准备：Graphiti + 托管 Neo4j/AuraDB（不是 Postgres）
# 说明：当前仓库仅完成 provider 选择与环境校验的前置缝合，
# 真正的 build/search/update 运行时适配仍需后续迁移。
# GRAPH_BACKEND_PROVIDER=graphiti
# NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
